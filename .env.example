# Sellers connect their own keys through /connect. These are the operator's settings.
# 32 random bytes as hex: openssl rand -hex 32. Encrypts API keys and webhook secrets at rest.
ENCRYPTION_KEY=
# Shared secret the cron (or local timer) sends to /api/tick
CRON_SECRET=
# Postgres URL for hosted deployments; leave empty to use SQLite at DB_PATH
DATABASE_URL=
# Public URL of this server, used by `npm run register`
PUBLIC_URL=https://curfew.example.com
# Defaults for new shops; each shop can change them in Settings.
REFUND_DELAY_MIN=10
IMMEDIATE_REVOKE=0
WINDOW_MIN=10
LEARN_DAYS=60
PORT=8787
DB_PATH=./curfew.db
