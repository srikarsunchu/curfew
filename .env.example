# Whop account API key (needs payment:manage, membership:manage, webhook scopes)
WHOP_API_KEY=
# Whop account id (biz_...) - optional, narrows list calls
WHOP_ACCOUNT_ID=
# ws_... secret returned when the webhook is created (npm run register prints it)
WHOP_WEBHOOK_SECRET=
# Public URL of this server, used by `npm run register`
PUBLIC_URL=https://curfew.example.com
# Alert sink: any incoming-webhook URL (Slack, Discord, Telegram bridge)
ALERT_WEBHOOK_URL=
# Minutes an incident holds before refund+revoke fires. Undo within this window.
REFUND_DELAY_MIN=10
# Set to 1 to revoke access immediately on attack (refund still waits)
IMMEDIATE_REVOKE=0
# Rolling window in minutes used by the detector
WINDOW_MIN=10
PORT=8787
DB_PATH=./curfew.db
