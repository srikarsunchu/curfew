{
  "name": "nightlatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Merchant-side fraud nightlatch for Whop. Learns your normal, watches the webhook stream, contains an attack before it becomes chargebacks.",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "learn": "node --env-file-if-exists=.env src/cli.ts learn",
    "register": "node --env-file-if-exists=.env src/cli.ts register",
    "simulate": "node src/simulate.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": { "@types/node": "^22.15.0", "typescript": "^5.7.3" }
}
